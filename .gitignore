# ===== 运行时生成的文件（每个用户各自生成，绝不提交）=====
# 视频索引：包含本地绝对路径、账号 openid 等个人信息
library.json

# 用户个人配置：包含本机视频目录路径
config.json

# 用户的收藏、改名、隐藏记录
overrides.json

# 用户的自定义标签
tags.json

# 回收站索引
trash_index.json

# 回收站目录（删除的视频文件本体）
回收站/

# ===== 日志与缓存 =====
*.log
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
venv/
env/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ===== 本地设计草稿（内含个人路径，仅本地保留）=====
design/

# ===== 临时文件 =====
_*.py
_*.js
_*.log

# ===== 宣传片相关（本地构建产物，不提交）=====
*.mp4
_video_src/

# ===== NAS 本地部署数据与构建产物，不提交 =====
data/
media/
dist/
.env
.env.*
!.env.example
